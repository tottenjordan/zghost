}
skinparam node {
    BackgroundColor #EA4335
    BorderColor #E0E0E0
    FontColor #FFF
    Shadowing false
}
skinparam queue {
    BackgroundColor #34A853
    BorderColor #E0E0E0
    FontColor #FFF
    Shadowing false
}


title Trends & Insights - Simplified Pipeline

start
:TRENDS\n(Deterministic);
note right
  BigQuery + YouTube API
  No LLM in autopilot
end note

:RESEARCH\n(LLM Agent);
note right
  research_agent
  Google Search + Memory
end note

:AD_CREATIVE\n(LLM Agent);
note right
  ad_creative_agent
  Draft/Critique/Select
end note

:IMAGE_GEN\n(Deterministic);
note right
  Imagen 4 + Gecko
  3 ASSET images
end note

:AV_STUDIO\n(Deterministic);
note right
  Veo 3.1 Fast
  Single 8s clip
end note

:FOCUS_GROUP\n(LLM Agent);
note right
  focus_group_evaluator_agent
  3-person simulation
end note

:SAVE_REPORT\n(Tool);
note right
  Branded PDF to GCS
  No LLM
end note

stop
@endum
