title Trends & Insights - Functional Architecture (Flat 2-Level)

package "Deterministic Orchestrator" {
  [Campaign Orchestrator\n(BaseAgent State Machine)] as Orchestrator #4285F4
}

package "LLM Sub-Agents (3)" {
  [research_agent\n(google_search, recall_prior_insights)] as Research #EA4335
  [ad_creative_agent\n(save_select_ad_copy, save_select_visual_concept)] as Creative #FBBC05
  [focus_group_evaluator_agent\n(analyze_commercial_video, portraits)] as Eval #34A853
}

package "Google Cloud" {
  database "BigQuery" as BQ #4285F4
  cloud "Cloud Storage" as GCS #4285F4
  cloud "Vertex AI\n(Imagen 4 / Veo 3.1 / Gecko)" as Vertex #4285F4
}

package "External" {
  node "YouTube API" as YT #White
  node "Google Search" as GS #White
}

' Relationships
Orchestrator --> BQ : 1. TRENDS (deterministic)
Orchestrator --> YT : 1. TRENDS (deterministic)
Orchestrator --> Research : 2. RESEARCH
Orchestrator --> Creative : 3. AD_CREATIVE
Orchestrator --> Vertex : 4-5. IMAGE_GEN + AV_STUDIO (deterministic)
Orchestrator --> Eval : 6. FOCUS_GROUP
Orchestrator --> GCS : 7. SAVE_REPORT (branded PDF)

Research --> GS : google_search
Research --> Vertex : recall_prior_insights (Memory Bank)
Eval --> Vertex : Analyze video

Vertex ..> GCS : Read/Write Assets

@enduml
