title Trends & Insights - System Architecture (Flat 2-Level)

package "Orchestration Layer" {
  agent "Campaign\nOrchestrator\n(BaseAgent)" as Root #LightBlue
  note right of Root
    Deterministic state machine
    All stages inlined
    No nested orchestrators
  end note
}

package "LLM Agents (3 total)" {
  agent "Research\nAgent" as Research #LightYellow
  agent "Ad Creative\nAgent" as AdCreative #LightCyan
  agent "Focus Group\nEvaluator" as Eval #LightGreen
}

package "Deterministic SDK Calls" {
  component "Imagen 4\n(3 ASSET refs)" as Imagen #FBBC05
  component "Gecko\n(Fidelity Scoring)" as Gecko #FBBC05
  component "Veo 3.1\n(ASSET references)" as Veo #FBBC05
}

package "External Services" {
  cloud "Google Cloud Storage" as GCS #White
  database "BigQuery" as BQ #White
  node "YouTube API" as YT #White
  node "Google Search" as GS #White
  cloud "Vertex AI / Agent Engine\n(Memory Bank)" as AE #White
}

' Relationships
Root --> BQ : 1. TRENDS (deterministic)
Root --> YT : 1. TRENDS (deterministic)
Root --> Research : 2. RESEARCH
Root --> AdCreative : 3. AD_CREATIVE
Root --> Imagen : 4. IMAGE_GEN
Root --> Gecko : 4. Gecko scoring
Root --> Veo : 5. AV_STUDIO
Root --> Eval : 6. FOCUS_GROUP
Root --> GCS : 7. SAVE_REPORT (PDF)

Research --> GS : google_search tool
Research --> AE : recall_prior_insights

Imagen --> GCS : Save images
Veo --> GCS : Save video

Eval --> GCS : Read assets

@enduml
