@startuml
skinparam Handwritten false
skinparam Monochrome false
skinparam BackgroundColor #FFFFFF
skinparam Shadowing false
skinparam Padding 10
skinparam BoxPadding 10

' Participant Styles
skinparam ParticipantBackgroundColor #4285F4
skinparam ParticipantBorderColor #3367D6
skinparam ParticipantFontColor #FFFFFF

' Actor Styles
skinparam ActorBackgroundColor #EA4335
skinparam ActorBorderColor #B32015

' Database Styles
skinparam DatabaseBackgroundColor #FBBC05
skinparam DatabaseBorderColor #D08700

' Arrow Styles
skinparam ArrowColor #5F6368
skinparam ArrowThickness 1.5

' LifeLine Styles
skinparam LifeLineBorderColor #5F6368
skinparam LifeLineBackgroundColor #E8F0FE


title Research Pipeline Orchestrator Flow

participant "Orchestrator" as Orch
participant "Memory Recall" as Recall
participant "Parallel Planner" as PP
participant "Merge Insights" as Merge
participant "Web Evaluator" as Eval
participant "Save Report Tool" as Save

Orch -> Recall: 1. Recall (Deterministic)
Recall --> Orch: Insights

Orch -> PP: 2. Parallel Research (via parallel_planner_agent)
PP --> Orch: Summaries

Orch -> Merge: 3. Merge Insights (Deterministic)
Merge --> Orch: Combined Summary

Orch -> Eval: 4. Evaluate (via combined_web_evaluator)
Eval --> Orch: Feedback & Queries

Orch -> Save: 5. Save Report (Deterministic)
Save --> Orch: Status

@endum
