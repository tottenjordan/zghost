title Trends & Insights - AV Studio (Single-Clip Veo)

package "Input Assets" {
  [Product ASSET Image] as ProductAsset
  [Trend ASSET Image] as TrendAsset
  [Ad Copy & Visual Concept] as Concept
}

package "Gecko Fidelity Scoring" {
  [Score Product ASSET] as ScoreProd
  [Score Trend ASSET] as ScoreTrend
  [Select Best 2 References] as Select
}

package "Veo 3.1 Fast" {
  component "Single Commercial Clip" as Veo {
    [8s Commercial Generation] as Gen
    [ASSET References Only] as Refs
  }
}

package "Output" {
  [Commercial MP4] as Final
  database "Cloud Storage (GCS)" as GCS
}

' Relationships
ProductAsset --> ScoreProd : 1. Evaluate
TrendAsset --> ScoreTrend : 1. Evaluate

ScoreProd --> Select : 2. Filter
ScoreTrend --> Select : 2. Filter

Select --> Refs : 3. Top 2 ASSET refs
Concept --> Gen : Text prompt

Refs --> Gen : Condition
Gen --> Final : 4. Produce

Final --> GCS : 5. Upload

@endum
