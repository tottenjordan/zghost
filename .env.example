# Google Cloud Configuration
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_PROJECT_NUMBER=your-project-number
GOOGLE_CLOUD_LOCATION=us-central1

# GCS Bucket for artifacts
BUCKET=your-gcs-bucket-name

# YouTube API Secret (in Secret Manager)
YT_SECRET_MNGR_NAME=your-youtube-api-secret-name

# Optional: Session state preset JSON
# SESSION_STATE_JSON_PATH=example_state_pixel.json

# Optional: Agent Engine ID for memory bank
# MEMORY_BANK_AGENT_ENGINE_ID=your-agent-engine-id

# ============================================================================
# MCP Server Configuration (Model Context Protocol)
# See MCP_SERVERS_SETUP.md for detailed setup instructions
# ============================================================================

# GitHub MCP Server - Repository management, CI/CD, PRs, issues
# Get token at: https://github.com/settings/tokens
# Required scopes: repo, workflow, read:org
GITHUB_TOKEN=your_github_personal_access_token

# Sentry MCP Server - Error tracking and monitoring (Optional)
# Get token at: https://sentry.io/settings/account/api/auth-tokens/
# SENTRY_AUTH_TOKEN=your_sentry_auth_token
# SENTRY_ORG=your_organization_name
# SENTRY_PROJECT=your_project_name

# Slack MCP Server - Team communication and notifications (Optional)
# Create app at: https://api.slack.com/apps
# Required scopes: channels:history, channels:read, chat:write, files:read, search:read, users:read
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_APP_TOKEN=xapp-your-app-token

# Figma MCP Server - Design system integration (Optional)
# Get token at: https://www.figma.com/developers/api#access-tokens
# FIGMA_TOKEN=your_figma_personal_access_token

# Note: Puppeteer and Memory MCP servers require no configuration
